# Chave do Google AI Studio (https://aistudio.google.com/apikey). Obrigatória para o agent responder.
GEMINI_API_KEY=
# Modelo Gemini usado pelo agent. Alternativa com mais qualidade e menos cota: gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite
# Segredo para assinar o cookie de sessão (mínimo 16 caracteres). Troque em qualquer uso fora da sua máquina.
SESSION_SECRET=troque-este-segredo-local
# Abaixo desta confiança (0-100) o agent transfere a conversa para um analista.
AGENT_CONFIDENCE_THRESHOLD=60
# Mensagens do funcionário ao agent por conversa.
AGENT_MESSAGE_LIMIT=30
# Chance (0-1) de cada chamada ao serviço de chamados abrir uma janela de indisponibilidade. 0 desliga.
TICKETS_OUTAGE_RATE=0.1
# Duração da janela de indisponibilidade simulada, em segundos.
TICKETS_OUTAGE_SECONDS=4
APP_DB_PATH=./data/app.db
TICKETS_DB_PATH=./data/tickets.db
# Pausa entre turnos da suíte de avaliação (free tier do Gemini tem limite por minuto).
EVAL_DELAY_MS=4000
